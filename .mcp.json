{
    "mcpServers": {
        "godot": {
            "type": "stdio",
            "command": "npx",
            "args": [
                "@coding-solo/godot-mcp"
            ],
            "env": {
                "GODOT_PATH": "../pathogenic-files/Godot_v4.7-stable_mono_win64/Godot_v4.7-stable_mono_win64.exe"
            }
        },
        "context7": {
            "type": "http",
            "url": "https://mcp.context7.com/mcp",
            "headers": {
                "CONTEXT7_API_KEY": "${CONTEXT7_API_KEY}"
            }
        }
    }
}
