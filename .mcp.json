{
    "mcpServers": {
        "godot": {
            "type": "stdio",
            "command": "npx",
            "args": [
                "@coding-solo/godot-mcp"
            ],
            "env": {
                "GODOT_PATH": "${GODOT_PATH}"
            }
        },
        "context7": {
            "type": "http",
            "url": "https://mcp.context7.com/mcp",
            "headers": {
                "CONTEXT7_API_KEY": "${CONTEXT7_API_KEY}"
            }
        }
    }
}
