# This repo is the mod itself: manifest.json, mod_main.gd, extensions/, scenes/.
# Everything else here is local scratch. The game, the engine and the tooling live
# in the untracked sibling ../pathogenic-files/ and are never committed from here.

# Godot editor cache and export artifacts (regenerated on open; ~1.3 GB here)
.godot/
.import/
export_presets.cfg
*.translation

# Built mod archives (deploy_mod.ps1 writes to ../pathogenic-files/, but keep this
# in case a build is ever run with the output pointed here). Covers mod-hooks.zip.
*.zip

# Local tooling / scratch
tmp/
*.log
.c7_cache/

# Editor and machine-local settings.
# settings.local.json holds the real CONTEXT7_API_KEY that .mcp.json references as
# ${CONTEXT7_API_KEY} - it must never be committed. Note this ignores only that one
# file, so a shared .claude/settings.json or .claude/skills/ would still be tracked.
.vscode/
.idea/
.claude/settings.local.json

# OS junk
Thumbs.db
ehthumbs.db
desktop.ini
.DS_Store
